# Copy to backend/.env for local runs only. On Render these are set in the service's Environment tab. Never commit the real values.
MONGO_URL=
DB_NAME=jmk

# Long random values (different from Festive Buddy's). Make each with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
PIN_PEPPER=

# Used ONLY on the very first start to create the two logins (4 or 6 digits).
SUPER_ADMIN_PIN=
OWNER_PIN=
OWNER_ID=geetansh
OWNER_NAME=Geetansh Ahuja

# Optional: Google AI Studio key. Empty = photo reading is off, everything else works.
GEMINI_API_KEY=

CLIENT_ID=jmk
CORS_ORIGINS=https://jmk.sai.markets
PLAN_PRICE_INR=5000
# JMK: no AI limit at all
AI_UNLIMITED=1
# Bot language for the owner: en = simple English, hi = Hinglish (labour always Hinglish unless changed)
OWNER_LANG=en
AI_BUDGET_PERCENT=6

# ---- AI employee (in-app chat + WhatsApp bot) ----
# Claude reads money/stock messages (best at messy Hinglish). Without it, Gemini does everything.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_FAST_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (bot stays OFF until all four are set)
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
